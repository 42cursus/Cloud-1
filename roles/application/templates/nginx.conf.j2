resolver 127.0.0.11 valid=15s ipv6=off;
resolver_timeout 5s;

upstream wordpress_fpm {
    zone wordpress_fpm 64k;
    server wordpress:9000 resolve;
}

upstream phpmyadmin_http {
    zone phpmyadmin_http 64k;
    server phpmyadmin:80 resolve;
}

server {
    listen 80 default_server;
    server_name {{ cloud1_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name {{ cloud1_domain }};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% if cloud1_tls_mode == 'letsencrypt' %}
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    root /var/www/html;
    index index.php index.html;
    client_max_body_size 64m;

    location = /phpmyadmin {
        return 301 /phpmyadmin/;
    }

    location ^~ /phpmyadmin/ {
        auth_basic "Cloud-1 database administration";
        auth_basic_user_file /etc/nginx/phpmyadmin.htpasswd;

        proxy_pass http://phpmyadmin_http/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Prefix /phpmyadmin;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass wordpress_fpm;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_HOST $host;
    }

    location ~ /\. {
        deny all;
    }
}
