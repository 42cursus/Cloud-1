---
name: {{ cloud1_project_name }}

services:
  mariadb:
    image: {{ cloud1_mariadb_image }}
    container_name: cloud1-mariadb
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: {{ cloud1_database_name }}
      MARIADB_USER: {{ cloud1_database_user }}
      MARIADB_PASSWORD_FILE: /run/secrets/wordpress_db_password
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/mariadb_root_password
    secrets:
      - mariadb_root_password
      - wordpress_db_password
    volumes:
      - mariadb_data:/var/lib/mysql
    networks:
      - database
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 24
      start_period: 20s

  wordpress:
    image: {{ cloud1_wordpress_image }}
    container_name: cloud1-wordpress
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: mariadb:3306
      WORDPRESS_DB_NAME: {{ cloud1_database_name }}
      WORDPRESS_DB_USER: {{ cloud1_database_user }}
      WORDPRESS_DB_PASSWORD_FILE: /run/secrets/wordpress_db_password
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_HOME', '{{ cloud1_url }}');
        define('WP_SITEURL', '{{ cloud1_url }}');
        define('FORCE_SSL_ADMIN', true);
        define('DISALLOW_FILE_EDIT', true);
    secrets:
      - wordpress_db_password
    volumes:
      - wordpress_data:/var/www/html
    networks:
      - frontend
      - database
    healthcheck:
      test: ["CMD-SHELL", "php-fpm -t"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s

  phpmyadmin:
    image: {{ cloud1_phpmyadmin_image }}
    container_name: cloud1-phpmyadmin
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      PMA_HOST: mariadb
      PMA_PORT: "3306"
      PMA_ABSOLUTE_URI: "{{ cloud1_url }}/phpmyadmin/"
      UPLOAD_LIMIT: 64M
    networks:
      - frontend
      - database

  nginx:
    image: {{ cloud1_nginx_image }}
    container_name: cloud1-nginx
    restart: unless-stopped
    depends_on:
      wordpress:
        condition: service_healthy
      phpmyadmin:
        condition: service_started
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - wordpress_data:/var/www/html:ro
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ cloud1_tls_dir }}:/etc/nginx/tls:ro
      - {{ cloud1_secrets_dir }}/phpmyadmin.htpasswd:/etc/nginx/phpmyadmin.htpasswd:ro
      - {{ cloud1_acme_dir }}:/var/www/certbot:ro
    networks:
      - frontend
    healthcheck:
      test: ["CMD-SHELL", "wget -q --no-check-certificate -O /dev/null https://127.0.0.1/"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s

  wordpress-cli:
    image: {{ cloud1_wordpress_cli_image }}
    profiles: ["tools"]
    depends_on:
      mariadb:
        condition: service_healthy
      wordpress:
        condition: service_healthy
    entrypoint: ["/bin/sh", "/usr/local/bin/cloud1-wordpress-init"]
    environment:
      WORDPRESS_DB_HOST: mariadb:3306
      WORDPRESS_DB_NAME: {{ cloud1_database_name }}
      WORDPRESS_DB_USER: {{ cloud1_database_user }}
      WORDPRESS_DB_PASSWORD_FILE: /run/secrets/wordpress_db_password
      WORDPRESS_URL: {{ cloud1_url }}
      WORDPRESS_TITLE: "{{ cloud1_wordpress_title }}"
      WORDPRESS_ADMIN_USER: {{ cloud1_wordpress_admin_user }}
      WORDPRESS_ADMIN_EMAIL: {{ cloud1_wordpress_admin_email }}
    secrets:
      - wordpress_db_password
      - wordpress_admin_password
    volumes:
      - wordpress_data:/var/www/html
      - ./scripts/wordpress-init.sh:/usr/local/bin/cloud1-wordpress-init:ro
    networks:
      - database

secrets:
  mariadb_root_password:
    file: {{ cloud1_secrets_dir }}/mariadb_root_password
  wordpress_db_password:
    file: {{ cloud1_secrets_dir }}/wordpress_db_password
  wordpress_admin_password:
    file: {{ cloud1_secrets_dir }}/wordpress_admin_password

volumes:
  wordpress_data:
    name: cloud1_wordpress_data
  mariadb_data:
    name: cloud1_mariadb_data

networks:
  frontend:
    name: cloud1_frontend
  database:
    name: cloud1_database
    internal: true
