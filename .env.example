CLOUD1_NGINX_IMAGE=docker.io/library/nginx:1.28-alpine
CLOUD1_MARIADB_IMAGE=docker.io/library/mariadb:11.8
CLOUD1_WORDPRESS_IMAGE=docker.io/library/wordpress:6.8-php8.3-fpm-alpine
CLOUD1_WORDPRESS_CLI_IMAGE=docker.io/library/wordpress:cli-php8.3
CLOUD1_PHPMYADMIN_IMAGE=docker.io/library/phpmyadmin:5.2-apache

CLOUD1_DATABASE_NAME=wordpress
CLOUD1_DATABASE_USER=wordpress
CLOUD1_URL=https://cloud1.example.org
CLOUD1_WORDPRESS_TITLE="Cloud-1"
CLOUD1_WORDPRESS_ADMIN_USER=cloud1_admin
CLOUD1_WORDPRESS_ADMIN_EMAIL=admin@example.invalid

CLOUD1_TLS_DIR=/etc/cloud-1/tls
CLOUD1_SECRETS_DIR=/etc/cloud-1/secrets
CLOUD1_ACME_DIR=/var/lib/cloud-1/acme
